# API 启动（lifespan）会自动把本文件加载进进程环境（override=False：只补缺失变量，
# 不覆盖已 export 的；文件缺失/解析失败静默）。systemd 服务 WorkingDirectory=仓库根即可生效。
# ---- storage (D drive: datasets / models / caches, host-side) ----
RAGM_DATA_ROOT=/run/media/myj/D/rag_m
# ---- docker volumes (must stay under $HOME: Docker Desktop shares only $HOME) ----
DOCKER_VOLUME_DIRECTORY=./.volumes
# ---- vector db ----
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=rag_chunks
# ---- graph db (optional profile) ----
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ragm-local-dev
# 若 7474/7687 被其他 Neo4j 占用，可改映射端口并同步 NEO4J_URI
# NEO4J_HTTP_PORT=7475
# NEO4J_BOLT_PORT=7688
# ---- llm (OpenAI-compatible: Ollama / DeepSeek) ----
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=gemma4:31b-cloud
LLM_API_KEY=ollama
# DeepSeek alternative (needs paid key):
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# ---- classifier (rules | prompt | lora) ----
CLASSIFIER_BACKEND=rules
# CLASSIFIER_RUN_DIR=/run/media/myj/D/rag_m/models/classifier/s2_06b_rslora
CLASSIFIER_THRESHOLD=0.6

# ---- embeddings ----
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
EMBED_BATCH_SIZE=16
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# ---- hf mirror (network-restricted) ----
HF_ENDPOINT=https://hf-mirror.com
HF_HOME=/run/media/myj/D/rag_m/hf_cache
MODELSCOPE_CACHE=/run/media/myj/D/rag_m/ms_cache
# ---- observability: LangSmith (设置 API key 后启用) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-m
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- agentic ----
AGENT_MAX_ITERATIONS=3
WEB_SEARCH_URL=http://127.0.0.1:8080/search
WEB_SEARCH_K=5

# ---- v1.1: 多轮会话 / MCP / LLM provider 链 / 异步入库 ----
SESSION_DB_PATH=
SESSION_MAX_TURNS=6
SESSION_MAX_CHARS=4000
# 指代消解 + 子问题拆解开关（关闭 = 只做纯检索）
SESSION_REWRITE_ENABLED=true

MCP_ENABLED=false
MCP_SANDBOX_ROOT=
MCP_CONFIRM_TTL_S=60
# 确认 token 的 HMAC secret；留空 = 进程内随机（重启后未消费 token 失效）
MCP_CONFIRM_SECRET=

# 内置链：opencode-go（本机 relay）→ ollama gemma4:31b-cloud → 本地 ollama qwen2.5:1.5b-instruct
# （gemma4 免费额度 402 时自动落到本地小模型，质量有限）；key 只从环境变量读
# 模型名必须与 relay 的 GET /v1/models 一致（本机实际为 deepseek-v4.1-flash）
# relay 还需每次请求带 x-opencode-session；内置链已配置 "extra_headers":{"x-opencode-session":"$UUID"}
# （$UUID 由 LLMClient 每次请求替换为新的 uuid4，也可在 LLM_PROVIDERS 里覆盖）
# OPENCODE_GO_API_KEY=
# 留空 = 使用内置 provider 链（opencode-go → ollama）
LLM_PROVIDERS=
LLM_CHAT_TIMEOUT=60
LLM_FIRST_TOKEN_TIMEOUT=15

JOBS_DB_PATH=
JOBS_WORKER=true
# 总尝试次数（1 次初始 + 3 次重试）；不是单纯的重试次数
JOBS_MAX_ATTEMPTS=4

# ---- 代码库分析（Python + SQLite FTS5） ----
CODE_ENABLED=true
# 空 = $DATA_ROOT/data/code_index.sqlite（与 scripts/index_code.py 默认一致）
CODE_DB_PATH=
# JSON 数组；未设置 = [当前用户 home]；显式 [] = 全部拒绝（API 与 Indexer 语义一致）
# CODE_ALLOWED_ROOTS=["/path/to/repos"]
