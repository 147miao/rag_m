# ---- storage (D drive: datasets / models / caches, host-side) ----
RAGM_DATA_ROOT=/run/media/myj/D/rag_m
# ---- docker volumes (must stay under $HOME: Docker Desktop shares only $HOME) ----
DOCKER_VOLUME_DIRECTORY=./.volumes
# ---- vector db ----
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=rag_chunks
# ---- graph db (optional profile) ----
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ragm-local-dev
# ---- llm (OpenAI-compatible: Ollama / DeepSeek) ----
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=gemma4:31b-cloud
LLM_API_KEY=ollama
# DeepSeek alternative (needs paid key):
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# ---- classifier (rules | prompt | lora) ----
CLASSIFIER_BACKEND=rules
# CLASSIFIER_RUN_DIR=/run/media/myj/D/rag_m/models/classifier/s2_06b_rslora
CLASSIFIER_THRESHOLD=0.6

# ---- embeddings ----
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
EMBED_BATCH_SIZE=16
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# ---- hf mirror (network-restricted) ----
HF_ENDPOINT=https://hf-mirror.com
HF_HOME=/run/media/myj/D/rag_m/hf_cache
MODELSCOPE_CACHE=/run/media/myj/D/rag_m/ms_cache
